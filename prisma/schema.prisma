generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  USER
}

enum AuditAction {
  LOGIN_SUCCESS
  LOGIN_FAILURE
  LOGOUT
  TOTP_ENABLED
  TOTP_DISABLED
  BACKUP_CODES_DELETED
  BACKUP_CODES_REGENERATED
  BACKUP_CODE_USED
  PASSKEY_ADDED
  PASSKEY_REMOVED
  SHORT_LINK_CREATED
  SHORT_LINK_UPDATED
  SHORT_LINK_DELETED
  SHORT_LINK_ARCHIVED
  API_TOKEN_CREATED
  API_TOKEN_REVOKED
  SETTINGS_CHANGED
}

model User {
  id            String           @id @default(cuid())
  email         String           @unique
  name          String?
  passwordHash  String
  role          UserRole         @default(USER)
  displayTimeZone String?
  mobileMenuSide String          @default("right")
  linkListPageSize Int           @default(20)
  recentClickPageSize Int        @default(20)
  uploadMaxBytes BigInt?
  uploadLimitUnlimited Boolean   @default(false)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  lastLoginAt   DateTime?
  sessions      Session[]
  totpCredential TotpCredential?
  backupCodes   BackupCode[]
  passkeys      Passkey[]
  shortLinks    ShortLink[]      @relation("CreatedLinks")
  apiTokens     ApiToken[]
  auditLogs     AuditLog[]
}

model Session {
  id          String   @id @default(cuid())
  userId      String
  tokenHash   String   @unique
  ipHash      String?
  userAgent   String?
  createdAt   DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  expiresAt   DateTime
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model TotpCredential {
  id              String   @id @default(cuid())
  userId          String   @unique
  secretEncrypted String
  enabled         Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  enabledAt       DateTime?
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BackupCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String
  createdAt DateTime  @default(now())
  usedAt    DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
}

model Passkey {
  id           String   @id @default(cuid())
  userId       String
  name         String
  credentialId String   @unique
  publicKey    String
  counter      BigInt   @default(0)
  transports   String?
  backedUp     Boolean  @default(false)
  createdAt    DateTime @default(now())
  lastUsedAt   DateTime?
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ShortLink {
  id             String         @id @default(cuid())
  code           String         @unique
  destinationUrl String
  title          String?
  description    String?
  notes          String?
  enabled        Boolean        @default(true)
  archivedAt     DateTime?
  expiresAt      DateTime?
  maxClicks      Int?
  passwordHash   String?
  clickCount     Int            @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  lastClickedAt  DateTime?
  createdById    String?
  createdByApiTokenName   String?
  createdByApiTokenPrefix String?
  createdBy      User?          @relation("CreatedLinks", fields: [createdById], references: [id], onDelete: SetNull)
  clicks         ClickEvent[]
  tags           ShortLinkTag[]

  @@index([createdAt])
  @@index([enabled, expiresAt])
  @@index([clickCount])
}

model ClickEvent {
  id          String    @id @default(cuid())
  shortLinkId String
  occurredAt  DateTime  @default(now())
  referrer    String?
  userAgent   String?
  browser     String?
  device      String?
  country     String?
  region      String?
  ipAddress   String?
  ipHash      String?
  visitorHash String?
  shortLink   ShortLink @relation(fields: [shortLinkId], references: [id], onDelete: Cascade)

  @@index([shortLinkId, occurredAt])
  @@index([occurredAt])
  @@index([country])
}

model Tag {
  id        String         @id @default(cuid())
  name      String
  slug      String         @unique
  color     String?
  createdAt DateTime       @default(now())
  links     ShortLinkTag[]
}

model ShortLinkTag {
  shortLinkId String
  tagId       String
  shortLink   ShortLink @relation(fields: [shortLinkId], references: [id], onDelete: Cascade)
  tag         Tag       @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([shortLinkId, tagId])
}

model AuditLog {
  id         String      @id @default(cuid())
  userId     String?
  action     AuditAction
  entityType String?
  entityId   String?
  ipHash     String?
  userAgent  String?
  details    Json?
  createdAt  DateTime    @default(now())
  user       User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([action, createdAt])
}

model ApiToken {
  id          String    @id @default(cuid())
  userId      String
  name        String
  scopes      String    @default("links:create")
  tokenPrefix String
  tokenHash   String    @unique
  createdAt   DateTime  @default(now())
  expiresAt   DateTime?
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model CookieConsent {
  id          String   @id @default(cuid())
  consentId   String   @unique
  essential   Boolean  @default(true)
  analytics   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model RateLimitBucket {
  key       String   @id
  count     Int      @default(0)
  resetAt   DateTime
  updatedAt DateTime @updatedAt

  @@index([resetAt])
}
