{
  "name": "surls",
  "version": "1.14.1",
  "private": true,
  "description": "Surls is a personal short URL system for managing private links, redirects, and click statistics.",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "node scripts/clean-next-type-conflicts.mjs && prisma generate && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "seed": "tsx prisma/seed.ts",
    "seed:demo": "node scripts/seed-demo.mjs",
    "setup:admin": "tsx scripts/create-admin.ts",
    "import:yourls": "node scripts/import-yourls.mjs",
    "deploy:hmserv": "node scripts/deploy-hmserv.mjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.1",
    "argon2": "^0.44.0",
    "d3-geo": "^3.1.1",
    "i18n-iso-countries": "^7.14.0",
    "lucide-react": "^1.17.0",
    "next": "^16.2.7",
    "otplib": "^13.4.1",
    "pg": "^8.21.0",
    "prisma": "^7.8.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/d3-geo": "^3.1.0",
    "@types/node": "^25.9.2",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/topojson-client": "^3.1.5",
    "@vitest/coverage-v8": "^4.1.8",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.7",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "overrides": {
    "@hono/node-server": "^1.19.14",
    "postcss": "8.5.10"
  },
  "engines": {
    "node": ">=26.0.0"
  }
}
