POSTGRES_USER="surls"
POSTGRES_PASSWORD="replace-with-a-hex-postgres-password"
POSTGRES_DB="surls"
DATABASE_URL="postgresql://surls:replace-with-a-hex-postgres-password@localhost:5432/surls?schema=public"

SURLS_IMAGE="ghcr.io/aaronwhippo/surls:latest"
SURLS_APP_CONTAINER_NAME="surls-app"
SURLS_DB_CONTAINER_NAME="surls-db"
# Optional: include docker-compose.stack.yml when changing COMPOSE_PROJECT_NAME
# and set this to the existing Docker volume that contains Postgres data.
# SURLS_POSTGRES_VOLUME_NAME="surls-postgres"
SURLS_PORT="3000"
SURLS_PUBLIC_WEBROOT_PATH="./www"
SURLS_UPLOADS_PATH="./uploads"
UPLOAD_MAX_BYTES="26214400"
BASE_URL="http://localhost:3000"
APP_NAME="Surls"
AUTH_SECRET=""
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=""
SESSION_DAYS="14"
API_TOKEN_DAYS="90"
CLICK_EVENT_RETENTION_DAYS="365"
AUDIT_LOG_RETENTION_DAYS="365"
ALLOW_PRIVATE_DESTINATIONS="false"
TRUST_PROXY="false"
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
WEBAUTHN_RP_ID="localhost"
WEBAUTHN_ORIGIN="http://localhost:3000"

INITIAL_ADMIN_EMAIL=""
INITIAL_ADMIN_NAME="Surls Admin"
INITIAL_ADMIN_PASSWORD=""
SURLS_RUN_MIGRATIONS="true"
SURLS_RUN_BOOTSTRAP="true"
