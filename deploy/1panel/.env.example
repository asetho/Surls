POSTGRES_USER=surls
POSTGRES_PASSWORD=replace-with-a-hex-postgres-password
POSTGRES_DB=surls

SURLS_IMAGE=ghcr.io/asetho/surls:latest
SURLS_PORT=3000
SURLS_PUBLIC_WEBROOT_PATH=/opt/surls/www
SURLS_UPLOADS_PATH=/opt/surls/uploads
UPLOAD_MAX_BYTES=26214400
UPLOAD_USER_STORAGE_QUOTA_BYTES=1073741824
UPLOAD_SITE_STORAGE_QUOTA_BYTES=10737418240
BASE_URL=https://s.yourdomain.com
APP_NAME=Surls
AUTH_SECRET=
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
SESSION_DAYS=14
API_TOKEN_DAYS=90
CLICK_EVENT_RETENTION_DAYS=365
AUDIT_LOG_RETENTION_DAYS=365
ALLOW_PRIVATE_DESTINATIONS=false
TRUST_PROXY=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
WEBAUTHN_RP_ID=s.yourdomain.com
WEBAUTHN_ORIGIN=https://s.yourdomain.com

INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_NAME=Surls Admin
INITIAL_ADMIN_PASSWORD=replace-with-a-long-temporary-password
SURLS_RUN_MIGRATIONS=true
SURLS_RUN_BOOTSTRAP=true
